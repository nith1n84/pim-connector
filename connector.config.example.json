{
  "source": {
    "adapter": "akeneo",
    "config": {
      "url": "https://your-akeneo-domain.com",
      "clientId": "your_client_id",
      "secret": "your_secret",
      "username": "your_username",
      "password": "your_password",
      "locales": ["en_US", "ar_KW"],
      "scopes": ["ecommerce", "mobile"]
    }
  },
  "target": {
    "adapter": "vendure",
    "config": {
      "url": "http://localhost:3000/admin-api",
      "token": "your_vendure_token",
      "email": "superadmin",
      "password": "superadmin",
      "localeMap": {
        "en_US": "en",
        "ar_AE": "ar"
      },
      "channelMap": {
        "ecommerce": "2",
        "mobile": "3"
      }
    }
  },
  "mapping": {
    "attributeMap": {
      "sku": "identifier",
      "name": "values.name",
      "description": "values.description"
    }
  },
  "syncOptions": {
    "delayMs": 150,
    "retries": 3,
    "retryDelayMs": 1000
  }
}
